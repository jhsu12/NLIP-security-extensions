# Copy to .env (gitignored) and fill in. Load with: set -a; source .env; set +a

# Jetstream2 inference service through the Open WebUI proxy (works from any network).
# Create a key at https://llm.jetstream-cloud.org: Settings -> Account -> API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.jetstream-cloud.org/api

# Agent model: qwen-3.8-27b (default) or gemma-4-31b-it.
AGENT_MODEL=qwen-3.8-27b

# vLLM Semantic Router Decision API key (d3 judge), from https://decision.vllm-sr.ai
VSR_API_KEY=

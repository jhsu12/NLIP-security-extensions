# Copy to .env (gitignored) and fill in. Load with: set -a; source .env; set +a

# Agent model: qwen-3.8-27b (default) or gemma-4-31b-it.
AGENT_MODEL=qwen-3.8-27b

# Jetstream2 inference endpoint:
# Inside Jetstream, direct model endpoints work without an OpenAI API key:
#   https://llm.jetstream-cloud.org/<model>/v1/
# If OPENAI_BASE_URL is left empty, ToolGuard automatically uses the direct endpoint for AGENT_MODEL.
# If running outside Jetstream, set OPENAI_BASE_URL=https://llm.jetstream-cloud.org/api and provide OPENAI_API_KEY.
OPENAI_API_KEY=empty
OPENAI_BASE_URL=

# vLLM Semantic Router Decision API key (d3 judge), from https://decision.vllm-sr.ai
VSR_API_KEY=sk-vsr-0ktJwK7lR6u7d9M1Nw82lXfItb8TEMM8RKpBNoX2IAk

# Google sign-in (OAuth client of type "Desktop app"; see the workspace assistant README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google sign-in for the web demo (OAuth client of type "Web application"; no secret needed).
GOOGLE_WEB_CLIENT_ID=
